# Local secrets & environment
.env
.env.local
.env.*.local
!.env.example

# API tokens and other local secrets (never commit)
secrets/
*.token
ims-api-*.json

# SSH / TLS keys (never commit private keys)
server-keys/*
!server-keys/README.md
*.pem
*.key

# Node (Playwright layout verification scripts)
node_modules/
package-lock.json

# Build artifacts
bin/
*.exe
*.test
*.out

# Stray root binaries from `go build ./...` — one per cmd/, anchored to the repo
# root so the cmd/<name>/ source directories themselves stay tracked.
/collector
/estimate
/extforecast
/forecast
/forecastgust
/ims
/openwrf
/prediction
/server
/squall
/wgforecast

# Working notes, scratch files — local only
notes/
scratch/

# Logs & runtime
*.log

# AI assistant rules (server login and deploy details)
.cursor/

# OS & editors
.DS_Store
.idea/
.vscode/
*.swp
*~

# Docker local data (if bind-mounted)
ikite_mysql/

# Beget proxy with hardcoded secret (copy from proxy_post.php.example)
deploy/beget/proxy_post.php

# Legacy PHP site (contains DB credentials; reference only)
php/
